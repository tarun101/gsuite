{
  "name": "gsuite-mcp",
  "version": "0.6.0",
  "description": "Cloudflare-hosted multi-account Gmail, Sheets, Drive, Calendar, Docs, and Chat MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gsuite-upload": "dist/upload-cli.js"
  },
  "scripts": {
    "build": "tsc",
    "upload": "node dist/upload-cli.js",
    "bundle": "node scripts/bundle.mjs",
    "bundle:native": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/gsuite-mcp.cjs && esbuild src/auth-cli.ts --bundle --platform=node --format=cjs --outfile=dist/auth.cjs",
    "auth": "tsx src/auth-cli.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "deploy": "wrangler deploy",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "types:worker": "wrangler types worker-configuration.d.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.22.0",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.0",
    "@types/node": "^25.0.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.0",
    "esbuild-wasm": "^0.25.12",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
