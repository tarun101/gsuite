{
  "name": "gsuite-mcp",
  "version": "0.6.0",
  "description": "Local-first multi-account Gmail, Sheets, Drive, Calendar, Docs, and Chat MCP server.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle.mjs",
    "bundle:native": "esbuild src/index.ts --bundle --platform=node --format=cjs --outfile=dist/gsuite-mcp.cjs && esbuild src/auth-cli.ts --bundle --platform=node --format=cjs --outfile=dist/auth.cjs",
    "auth": "tsx src/auth-cli.ts",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "googleapis": "^173.0.0",
    "nodemailer": "^9.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.0",
    "esbuild-wasm": "^0.25.12",
    "tsx": "^4.22.0",
    "typescript": "^6.0.0"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  }
}
